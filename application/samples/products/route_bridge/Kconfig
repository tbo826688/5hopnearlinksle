#===============================================================================
# @brief    Kconfig for the dual-board SLE route bridge
#===============================================================================

choice
    prompt "Select the board side"
    default SAMPLE_SUPPORT_ROUTE_BRIDGE_RX

    config SAMPLE_SUPPORT_ROUTE_BRIDGE_RX
        bool "RX board: pure SLE Client -> UART1"

    config SAMPLE_SUPPORT_ROUTE_BRIDGE_TX
        bool "TX board: UART1 -> pure SLE Server"
endchoice

config ROUTE_BRIDGE_NODE_ID
    int
    prompt "Logical router id (R1=1, R2=2, R3=3, R4=4)"
    range 1 4
    default 1

config ROUTE_BRIDGE_UART_BUS
    int
    prompt "Bridge UART bus"
    range 1 1
    default 1

config ROUTE_BRIDGE_UART_TX_PIN
    int
    prompt "Bridge UART TX pin"
    range 15 15
    default 15

config ROUTE_BRIDGE_UART_RX_PIN
    int
    prompt "Bridge UART RX pin"
    range 16 16
    default 16

config ROUTE_BRIDGE_UART_BAUDRATE
    int
    prompt "Bridge UART baud rate"
    range 115200 4000000
    default 921600

config ROUTE_BRIDGE_OUTDOOR_LONG_RANGE
    bool
    prompt "Use the outdoor supervision timeout"
    default y

config SUPPORT_SLE_PERIPHERAL
    bool
    default y if SAMPLE_SUPPORT_ROUTE_BRIDGE_TX

config SUPPORT_SLE_CENTRAL
    bool
    default y if SAMPLE_SUPPORT_ROUTE_BRIDGE_RX
