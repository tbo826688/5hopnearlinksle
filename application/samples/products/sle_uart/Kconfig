config SLE_UART_BUS
    int
    prompt "Set the UART BUS of the currrent sample."
    default 0
    depends on SAMPLE_SUPPORT_SLE_UART
    help
        This option means the UART BUS of the currrent sample.
config UART_TXD_PIN
    int
    prompt "Choose UART TXD pin."
    depends on SAMPLE_SUPPORT_SLE_UART
    default 17

config UART_RXD_PIN
    int
    prompt "Choose UART RXD pin."
    depends on SAMPLE_SUPPORT_SLE_UART
    default 18

choice
    prompt "Select sle uart type"
    default SAMPLE_SUPPORT_SLE_UART_SERVER
    config SAMPLE_SUPPORT_SLE_UART_SERVER
        bool "Enable SLE UART Server sample."
    config SAMPLE_SUPPORT_SLE_UART_CLIENT
        bool "Enable SLE UART Client sample."
    # 【新增】增加主从一体选项
    config SAMPLE_SUPPORT_SLE_UART_ALL
        bool "Enable SLE UART Server & Client sample."
endchoice

config SAMPLE_FILE_TRANSFER_MODE
    bool "Enable end-to-end file transfer mode (UART<->SLE 5-hop)"
    depends on SAMPLE_SUPPORT_SLE_UART
    default n
    help
        When enabled, Node 1 reads bytes from CONFIG_SLE_UART_BUS and forwards
        them with a 12-byte header (magic+seq+CRC16) over the 5-hop link;
        Node 6 verifies CRC and writes verified payloads back to its UART.
        UART runs at 921600 baud. When disabled, the legacy 1400-byte
        synthetic throughput stream is used.

config SUPPORT_SLE_PERIPHERAL
    bool
    # 【修改】Server 或 All 模式支持 Peripheral
    default y if (SAMPLE_SUPPORT_SLE_UART_SERVER || SAMPLE_SUPPORT_SLE_UART_ALL)

config SUPPORT_SLE_CENTRAL
    bool
    # 【修改】Client 或 All 模式支持 Central
    default y if (SAMPLE_SUPPORT_SLE_UART_CLIENT || SAMPLE_SUPPORT_SLE_UART_ALL)
